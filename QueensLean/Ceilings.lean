import QueensLean.BoardCheck

/-!
# Exact ceilings from boards

Generated by `lean/tools/export_boards.py` from the paper's board files (`data/`). Each `C_n` states `⌊n/φ⌋ = k`, that
some `n`-queens solution has exactly `k` toroidal conflicts, and that none has more (so `C(n) = ⌊n/φ⌋`).
-/

namespace Ceilings

open Queens Ceiling Boards

/-- `C(6) = 3`. -/
theorem C_6 : ⌊(6 : ℝ) / Real.goldenRatio⌋ = 3 ∧
    (∃ p : Equiv.Perm (Fin 6), Function.Injective (vs p) ∧ Function.Injective (vd p) ∧ conf p = 3) ∧
    ∀ p : Equiv.Perm (Fin 6), Function.Injective (vs p) → Function.Injective (vd p) → conf p ≤ 3 :=
  ceiling_exact (L := [1, 3, 5, 0, 2, 4]) (by decide +kernel) (by norm_num) (by norm_num)

