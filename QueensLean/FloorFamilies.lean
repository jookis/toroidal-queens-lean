import QueensLean.Construct

/-!
# Floor solutions for all n (completed Monsky placements)

Generated by `lean/tools/floor_families_gen.py`. For each family `n = M u + n0` the completed Monsky board is given as
runs of queens with affine coordinates; `floor_sol u` proves it is a solution with exactly `f(n)` conflicts.
-/


namespace F36_38

open Queens Ceiling Construct

/-! `n = 36 * u + 38`: 5 runs of queens (start column, start row, number of queens, step). -/

def len (u : ℕ) : Fin 5 → ℕ := ![12 * u + 13, 6 * u + 6, 6 * u + 6, 12 * u + 12, 1]
def x0 (u : ℕ) : Fin 5 → ℕ := ![0, 12 * u + 13, 18 * u + 19, 24 * u + 25, 36 * u + 37]
def y0 (u : ℕ) : Fin 5 → ℕ := ![0, 1, 18 * u + 22, 2, 18 * u + 19]
def gx : Fin 5 → ℕ := ![1, 1, 1, 1, 0]
def gy : Fin 5 → ℕ := ![3, 3, 3, 3, 0]
abbrev I (u : ℕ) := Σ j : Fin 5, Fin (len u j)
def X (u : ℕ) (a : I u) : ℕ := x0 u a.1 + gx a.1 * a.2
def Y (u : ℕ) (a : I u) : ℕ := y0 u a.1 + gy a.1 * a.2
def Bs (u : ℕ) : Finset (I u) := Finset.univ.filter fun a => a.1 ∈ ({4} : Finset (Fin 5))
def Bd (u : ℕ) : Finset (I u) := Finset.univ.filter fun a => a.1 ∈ ({4} : Finset (Fin 5))

theorem card (u : ℕ) : Fintype.card (I u) = 36 * u + 38 := by
  rw [Fintype.card_sigma]
  simp only [Fintype.card_fin]
  simp [Fin.sum_univ_succ, len]
  ring

theorem hX (u : ℕ) (a : I u) : X u a < 36 * u + 38 := by
  obtain ⟨j, k⟩ := a
  have := k.isLt
  fin_cases j <;> simp [X, Y, x0, y0, gx, gy, len, Bs, Bd, Xor, Finset.mem_filter, Finset.mem_univ, true_and] at * <;> omega

theorem hY (u : ℕ) (a : I u) : Y u a < 36 * u + 38 := by
  obtain ⟨j, k⟩ := a
  have := k.isLt
  fin_cases j <;> simp [X, Y, x0, y0, gx, gy, len, Bs, Bd, Xor, Finset.mem_filter, Finset.mem_univ, true_and] at * <;> omega

theorem h1 (u : ℕ) (a b : I u) (h : a ≠ b) :
    X u a ≠ X u b ∧ Y u a ≠ Y u b ∧ X u a + Y u a ≠ X u b + Y u b ∧ X u a + Y u b ≠ X u b + Y u a := by
  have h' := sig_ne h
  clear h
  obtain ⟨j1, k1⟩ := a
  obtain ⟨j2, k2⟩ := b
  have := k1.isLt
  have := k2.isLt
  fin_cases j1 <;> fin_cases j2 <;> simp [X, Y, x0, y0, gx, gy, len, Bs, Bd, Xor, Finset.mem_filter, Finset.mem_univ, true_and] at * <;> omega

set_option trace.Meta.Tactic.simp false in
theorem hs (u : ℕ) (a b : I u) (h : a ≠ b) (e : X u a + Y u a = X u b + Y u b + (36 * u + 38)) :
    Xor (a ∈ Bs u) (b ∈ Bs u) := by
  simp only [Bs, Finset.mem_filter, Finset.mem_univ, true_and]
  have h' := sig_ne h
  clear h
  obtain ⟨j1, k1⟩ := a
  obtain ⟨j2, k2⟩ := b
  have := k1.isLt
  have := k2.isLt
  fin_cases j1 <;> fin_cases j2 <;> simp [X, Y, x0, y0, gx, gy, len, Bs, Bd, Xor, Finset.mem_filter, Finset.mem_univ, true_and] at * <;> omega

theorem hd (u : ℕ) (a b : I u) (h : a ≠ b) (e : Y u a + X u b = Y u b + X u a + (36 * u + 38)) :
    Xor (a ∈ Bd u) (b ∈ Bd u) := by
  simp only [Bd, Finset.mem_filter, Finset.mem_univ, true_and]
  have h' := sig_ne h
  clear h
  obtain ⟨j1, k1⟩ := a
  obtain ⟨j2, k2⟩ := b
  have := k1.isLt
  have := k2.isLt
  fin_cases j1 <;> fin_cases j2 <;> simp [X, Y, x0, y0, gx, gy, len, Bs, Bd, Xor, Finset.mem_filter, Finset.mem_univ, true_and] at * <;> omega

/-- **Floor solution** at every `n = 36 * u + 38`. -/
theorem floor_sol (u : ℕ) : ∃ p : Equiv.Perm (Fin (36 * u + 38)), Function.Injective (vs p) ∧
    Function.Injective (vd p) ∧ conf p = Layer.floorVal (36 * u + 38) := by
  have : NeZero (36 * u + 38) := ⟨by omega⟩
  obtain ⟨p, h2, h3, hc⟩ := build (X u) (Y u) (card u) (hX u) (hY u) (h1 u) (Bs u) (Bd u) (hs u) (hd u)
  have hB : (Bs u).card + (Bd u).card = 2 := by simp only [Bs, Bd, card_fst]; simp [len]
  have hf : Layer.floorVal (36 * u + 38) = 2 := by
    rw [floorVal_mod]
    have : (36 * u + 38) % 6 = 2 := by omega
    simp [this]
  exact ⟨p, h2, h3, le_antisymm (hf ▸ hB ▸ hc) (floor_le_conf p)⟩

end F36_38


