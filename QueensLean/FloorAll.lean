/-- With the lower bound: the fewest toroidal conflicts of a legal solution is exactly `f(n)`. -/
theorem floor_exact (n : ℕ) [NeZero n] (h2 : n ≠ 2) (h3 : n ≠ 3) :
    (∃ p : Equiv.Perm (Fin n), Function.Injective (vs p) ∧ Function.Injective (vd p) ∧
      conf p = Layer.floorVal n) ∧ ∀ p : Equiv.Perm (Fin n), Layer.floorVal n ≤ conf p :=
  ⟨floor_reached n h2 h3, floor_le_conf⟩

