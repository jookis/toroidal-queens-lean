/-!
# The floor is reached for every n except 2 and 3

Lemma `lem:completion` of the paper in Lean: for every `n ≠ 2, 3` there is a legal (flat) solution with exactly
`f(n)` toroidal conflicts (0, 2 or 3). Pólya's board for `gcd(n, 6) = 1`, the 28 completed Monsky families
(`FloorFamilies`, generated by `lean/export/construct_gen.py`) and six concrete boards for n = 4, 6, 8, 9, 12, 20.
-/

namespace Construct

open Queens Ceiling Boards

abbrev Sol (n : ℕ) [NeZero n] : Prop := ∃ p : Equiv.Perm (Fin n), Function.Injective (vs p) ∧
    Function.Injective (vd p) ∧ conf p = Layer.floorVal n

