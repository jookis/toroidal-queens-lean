/-- **The floor is reached**: for every `n ≠ 2, 3` some legal solution has exactly `f(n)` toroidal conflicts. -/
theorem floor_reached (n : ℕ) [NeZero n] (h2 : n ≠ 2) (h3 : n ≠ 3) : Sol n := by
  have hn := NeZero.ne n
  obtain ⟨r, hr, hr72⟩ : ∃ r, n % 72 = r ∧ r < 72 := ⟨_, rfl, Nat.mod_lt _ (by norm_num)⟩
  interval_cases r
  · exact of_F36_36 n (by omega) (by omega)
  · exact polya_sol (by omega)
  · exact of_F36_38 n (by omega) (by omega)
  · exact of_F24_27 n (by omega) (by omega)
  · by_cases hl : n < 40
    · obtain rfl : n = 4 := by omega
      exact small_4
    · exact of_F36_40 n (by omega) (by omega)
  · exact polya_sol (by omega)
  · by_cases hl : n < 78
    · obtain rfl : n = 6 := by omega
      exact small_6
    · exact of_F72_78 n (by omega) (by omega)
  · exact polya_sol (by omega)
  · by_cases hl : n < 80
    · obtain rfl : n = 8 := by omega
      exact small_8
    · exact of_F72_80 n (by omega) (by omega)
  · by_cases hl : n < 33
    · obtain rfl : n = 9 := by omega
      exact small_9
    · exact of_F24_33 n (by omega) (by omega)
  · exact of_F36_10 n (by omega) (by omega)
  · exact polya_sol (by omega)
  · by_cases hl : n < 48
    · obtain rfl : n = 12 := by omega
      exact small_12
    · exact of_F36_48 n (by omega) (by omega)
  · exact polya_sol (by omega)
  · exact of_F36_14 n (by omega) (by omega)
  · exact of_F24_15 n (by omega) (by omega)
  · exact of_F36_16 n (by omega) (by omega)
  · exact polya_sol (by omega)
  · exact of_F72_18 n (by omega) (by omega)
  · exact polya_sol (by omega)
  · by_cases hl : n < 92
    · obtain rfl : n = 20 := by omega
      exact small_20
    · exact of_F72_92 n (by omega) (by omega)
  · exact of_F24_21 n (by omega) (by omega)
  · exact of_F36_22 n (by omega) (by omega)
  · exact polya_sol (by omega)
  · exact of_F36_24 n (by omega) (by omega)
  · exact polya_sol (by omega)
  · exact of_F36_26 n (by omega) (by omega)
  · exact of_F24_27 n (by omega) (by omega)
  · exact of_F36_28 n (by omega) (by omega)
  · exact polya_sol (by omega)
  · exact of_F72_30 n (by omega) (by omega)
  · exact polya_sol (by omega)
  · exact of_F72_32 n (by omega) (by omega)
  · exact of_F24_33 n (by omega) (by omega)
  · exact of_F36_34 n (by omega) (by omega)
  · exact polya_sol (by omega)
  · exact of_F36_36 n (by omega) (by omega)
