  obtain ⟨p, h1, h2, h3, -⟩ := sound_val (n := 4) (k := 2) (L := [1, 3, 0, 2]) (by decide +kernel)
  exact ⟨p, h1, h2, by rw [h3, floorVal_mod]; norm_num⟩

