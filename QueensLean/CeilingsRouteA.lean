import QueensLean.BoardCheck

/-!
# Exact ceilings from boards

Generated by `lean/tools/export_boards.py` from the route A boards for 71-90 (`data/routeA_71_90_boards_out.txt`). Each `C_n` states `⌊n/φ⌋ = k`, that
some `n`-queens solution has exactly `k` toroidal conflicts, and that none has more (so `C(n) = ⌊n/φ⌋`).
-/

namespace CeilingsRouteA

open Queens Ceiling Boards

/-- `C(76) = 46`. -/
theorem C_76 : ⌊(76 : ℝ) / Real.goldenRatio⌋ = 46 ∧
    (∃ p : Equiv.Perm (Fin 76), Function.Injective (vs p) ∧ Function.Injective (vd p) ∧ conf p = 46) ∧
    ∀ p : Equiv.Perm (Fin 76), Function.Injective (vs p) → Function.Injective (vd p) → conf p ≤ 46 :=
  ceiling_exact (L := [32, 41, 27, 40, 42, 36, 30, 58, 18, 24, 60, 20, 23, 54, 37, 12, 68, 61, 16, 25, 53, 67, 64, 66, 4, 13, 56, 10, 2, 74, 46, 26, 31, 69, 47, 70, 75, 3, 72, 0, 5, 28, 6, 44, 49, 29, 1, 73, 65, 19, 62, 71, 9, 11, 8, 22, 50, 59, 14, 7, 63, 38, 21, 52, 55, 15, 51, 57, 17, 45, 39, 33, 35, 48, 34, 43]) (by decide +kernel) (by norm_num) (by norm_num)

